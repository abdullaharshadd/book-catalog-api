generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Book {
  id              Int      @id @default(autoincrement())
  title           String
  author          String
  genre           String?
  publication_year Int?
  description     String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([title, author])
  @@map("books")
}